+// (OM: pad slots) The slot that holds the pad with this SDL instance id, or -1.
+static int OmPadSlot(SDL_JoystickID id)
+{
+    for (int i = 0; i < MAX_GAMEPADS; i++)
+    {
+        if (platform.gamepad[i] && (SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(platform.gamepad[i])) == id)) return i;
+    }
+    return -1;
 }
 
+// (OM: pad slots) A pad gone: nothing of it stays held.
+static void OmPadClear(int i)
+{
+    memset(CORE.Input.Gamepad.currentButtonState[i], 0, sizeof(CORE.Input.Gamepad.currentButtonState[i]));
+    memset(CORE.Input.Gamepad.axisState[i], 0, sizeof(CORE.Input.Gamepad.axisState[i]));
+    CORE.Input.Gamepad.axisState[i][GAMEPAD_AXIS_LEFT_TRIGGER] = -1.0f;
+    CORE.Input.Gamepad.axisState[i][GAMEPAD_AXIS_RIGHT_TRIGGER] = -1.0f;
+}
